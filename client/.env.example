# ==========================================
# 贪吃蛇前端环境变量范本 (Client Environment Variables)
# ==========================================

# 后端 API 基础请求路径 (本地开发默认为 http://localhost:8080)
NEXT_PUBLIC_API_BASE=http://localhost:8080

# 前端站点部署公开 URL (本地开发默认为 http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
