# ==========================================
# 贪吃蛇后端环境变量范本 (Server Environment Variables)
# ==========================================

# 服务监听端口 (本地开发默认 8080，Azure Web App 对应 WEBSITES_PORT=8080)
PORT=8080

# Gin 运行模式: debug (本地开发模式) | release (生产高性能模式)
GIN_MODE=debug

# Supabase / PostgreSQL 云端数据库连接串 (URI 格式)
# 格式: postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres
