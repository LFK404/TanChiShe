# 后端监听端口 (默认 8080)
PORT=8080

# Gin 运行模式 (本地: debug | 生产: release)
GIN_MODE=release

# Level 3 防作弊对局令牌 HMAC-SHA256 签名私钥 (至少 32 字节高熵强随机字符串)
HMAC_SECRET_KEY=your_64_char_high_entropy_random_secret_here

# Supabase PostgreSQL IPv4 连接池连接串 (首尔节点 aws-0-ap-northeast-2, 端口 5432)
DATABASE_URL=postgresql://postgres.itouogbtujieqovjuuew:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
